# Copy to bridge/.env on the home server and fill in. bridge/.env is gitignored.

# ESP32 address on your LAN. Give the ESP32 a DHCP reservation in your router
# so this IP never changes. (Shown on the OLED / Serial Monitor at boot.)
ESP32_URL=http://192.168.1.50

# Password needed to water / change settings from the portfolio. Min 8 chars.
PLANT_PASSWORD=change-me-please

# Sites allowed to call this bridge from the browser (comma separated).
ALLOWED_ORIGINS=https://aniqbinlutpi.my,https://www.aniqbinlutpi.my,http://localhost:3000

# Keep 127.0.0.1 so only cloudflared on this machine can reach it.
HOST=127.0.0.1
PORT=8787

# Optional tuning
# ESP32_TIMEOUT_MS=5000   # how long to wait for the ESP32 per request
# STATUS_CACHE_MS=1500    # visitors share one reading for this long
# KEEPALIVE_MS=15000      # poll the ESP32 on a timer (0 = only when someone visits)
# ONLINE_GRACE_MS=45000   # still "online" if the ESP32 answered within this window
